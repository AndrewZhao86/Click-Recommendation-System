# ---- Infra ----
KAFKA_BOOTSTRAP=localhost:9094
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://clickrec:clickrec@localhost:5432/clickrec

# ---- LLM (Gemini-only, Phase 7) ----
# Either GOOGLE_API_KEY or GEMINI_API_KEY works — the latter is mirrored
# into GOOGLE_API_KEY at startup so the google-genai SDK picks it up.
# Per-use-case timeouts live in ranker.yaml (`llm:` section), not here.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_RUNTIME_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro

# ---- App ----
LOG_LEVEL=INFO
ENV=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Observability ----
OTEL_EXPORTER=stdout
PROMETHEUS_ENABLED=true
